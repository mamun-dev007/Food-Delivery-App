# Server configuration
PORT=5000
# Allow the Vite dev server to call the API during development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (native driver, Stable API)
# Provide your own credentials -- never commit a real URI.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.<cluster>.mongodb.net/?appName=Cluster0
# Database name (fixed per the project convention)
DB_NAME=Food-Delivery001

# ---------------------------------------------------------------------------
# Firebase Admin SDK (REQUIRED for token verification / authorization)
# ---------------------------------------------------------------------------
# Provide EITHER the full service-account JSON as a string, OR a file path.
#
#   Option A (string) — replace with the contents of your service-account JSON:
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","private_key_id":"...","client_id":"...","...":"..."}
#
#   Option B (path)  — point at your downloaded service-account JSON file:
#   FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\service-account.json

# Example (Option B):
FIREBASE_SERVICE_ACCOUNT_PATH=

# Legacy/auth secret (unused now that Firebase handles tokens; kept for
# backward compatibility only).
JWT_SECRET=dev-secret-change-me
